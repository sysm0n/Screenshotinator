# Build output
build/bin/
*.exe
*.app
*.dmg

# Frontend
node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
# generated by `wails dev` / `wails build`
frontend/wailsjs/
# Wails install cache
frontend/package.json.md5

# Go
*.test
*.out
coverage.*

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local data (never commit screenshots or settings with API keys)
*.db
*.db-wal
*.db-shm
settings.json
app.log
